  <Control>
    <Attribute ID="MDMXArm" Name="MDMX Arm" Description="" Group="S">
      <Locate Locate="2" PowerOn="1" />
      <Function ID="1" Name="Safe" Display="'SAFE'" Dmx="0~127" />
      <Function ID="2" Name="Armed" Display="'ARMED'" Dmx="128~255" />
    </Attribute>
    <Attribute ID="MDMXVersion" Name="Protocol V1" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="V1" Display="'V1'" Dmx="1~1" />
    </Attribute>
    <Attribute ID="MDMXProfile" Name="Profile 1" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Profile1" Display="'Profile 1'" Dmx="1~1" />
    </Attribute>
    <Attribute ID="MDMXBank" Name="Bank" Description="" Group="S">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Bank" Display="'Bank %.f',0~255" Dmx="0~255" />
    </Attribute>
    <Attribute ID="MDMXMaster" Name="Global Master" Description="" Group="I" Size="2">
      <Locate Locate="1:100" PowerOn="1:100" />
      <Function ID="1" Name="Global Master" Display="'Raw %.f',0~65535" Dmx="0~65535" />
    </Attribute>
    <Attribute ID="MDMXEnable" Name="Lane Enable" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Off" Display="'Off'" Dmx="0~127" />
      <Function ID="2" Name="On" Display="'On'" Dmx="128~255" />
    </Attribute>
    <Attribute ID="MDMXOpcode" Name="Operator" Description="" Group="E">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="Off" Display="'OFF'" Dmx="0~63" />
      <Function ID="2" Name="Set" Display="'SET'" Dmx="64~127" />
      <Function ID="3" Name="Ramp" Display="'RAMP'" Dmx="128~191" />
      <Function ID="4" Name="Wave" Display="'WAVE'" Dmx="192~255" />
    </Attribute>
    <Attribute ID="MDMXAttribute" Name="Target Attribute" Description="" Group="S">
      <Locate Locate="1" PowerOn="1" />
      <Function ID="1" Name="None" Display="'None'" Dmx="0~27" />
      <Function ID="2" Name="Dimmer" Display="'Dimmer'" Dmx="28~55" />
      <Function ID="3" Name="Pan" Display="'Pan'" Dmx="56~83" />
      <Function ID="4" Name="Tilt" Display="'Tilt'" Dmx="84~111" />
      <Function ID="5" Name="Red" Display="'Red'" Dmx="112~139" />
      <Function ID="6" Name="Green" Display="'Green'" Dmx="140~167" />
      <Function ID="7" Name="Blue" Display="'Blue'" Dmx="168~195" />
      <Function ID="8" Name="White" Display="'White'" Dmx="196~223" />
      <Function ID="9" Name="Zoom" Display="'Zoom'" Dmx="224~255" />
    </Attribute>
    <Attribute ID="MDMXFlags" Name="Flags" Description="" Group="S">
      <Locate Locate="1:0" PowerOn="1:0" />
      <Function ID="1" Name="Flags" Display="'Flags %.f',0~255" Dmx="0~255" />
